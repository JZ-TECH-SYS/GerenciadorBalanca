<!DOCTYPE html>
<html>
<head>
    <title>Produtos</title>
    <link rel="stylesheet" href="./../css/bootstrap5.0.2.min.css">
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col text-start"><h1>Peso X Valor</h1></div>
        </div>
        <div id="products-list" class="row">
            <!-- Peso e valor serão inseridos aqui via JavaScript -->
        </div>
    </div>

    <script src="./../js/bootstrap5.0.2.js"></script>
    <script>
        // Esta função pode ser chamada quando a página carrega para mostrar os produtos existentes
        function pesoValor(nome, peso, valor) {
            const productsList = document.getElementById('products-list');

            // Cria um novo card para o produto
            const productCard = document.createElement('div');
            const weightInKilos = +(peso / 1000).toFixed(3);
            const totalValue = weightInKilos * valor;
            productCard.className = 'col';
            productCard.innerHTML = `
                <div class="card m-0 p-0">
                    <div class="card-body m-0 p-0">
                        <h5 class="card-title m-1 p-0">${nome}</h5>
                        <p class="card-text m-0 p-0">Peso: ${weightInKilos} Kg/g</p>
                        <p class="card-text m-0 p-0">Valor KG: ${valor}g</p>
                        <h3 class="card-text">Valor: R$ ${totalValue.toFixed(2)}</h3>
                    </div>
                </div>
            `;

            // Adiciona o card à lista de produtos
            productsList.innerHTML = '';
            productsList.appendChild(productCard);
        }

        window.api.on('update-peso', (data) => {
            console.log(data);
            pesoValor(data.nome, data.peso, data.valor);
        });
        
        // Exemplo: adicionar um produto quando a página carrega
        window.onload = () => {
            pesoValor('Sem Produto', 0.0, 0.00);
        };
    </script>
</body>
</html>
