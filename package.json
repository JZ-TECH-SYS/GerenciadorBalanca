{
  "name": "gerenciador-balanca",
  "version": "3.0.0",
  "description": "Gerenciador para balança Urano UDC-CO 30/5 - Leitura de peso via porta serial e impressão de etiquetas",
  "main": "main.js",
  "license": "ISC",
  "author": "joaosn",
  "repository": {
    "type": "git",
    "url": "https://github.com/JZ-TECH-SYS/GerenciadorBalanca.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --exec electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder --windows",
    "dist": "electron-builder",
    "dist:all": "npm-run-all -p dist:*",
    "dist:mac": "electron-builder --mac",
    "dist:windows": "electron-builder --windows",
    "dist:linux": "electron-builder --linux",
    "bump": "node script/bumpVersion.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.6.4",
    "electron-rebuild": "^3.2.9",
    "eslint": "^5.16.0",
    "eslint-config-airbnb-base": "^13.2.0",
    "eslint-plugin-import": "^2.18.0",
    "nodemon": "^1.19.1"
  },
  "dependencies": {
    "@serialport/bindings": "^9.2.9",
    "axios": "^1.5.1",
    "electron-store": "^8.1.0",
    "node-thermal-printer": "^4.2.1",
    "printer": "^0.4.0",
    "ref-napi": "^3.0.3",
    "serialport": "^9.2.8"
  },
  "build": {
    "appId": "com.jztech.gerenciador-balanca",
    "productName": "Gerenciador Balanca",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "assets/**/*",
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/img/balanca.png",
      "publisherName": "JZ-TECH-SYS"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/img/balanca.png",
      "uninstallerIcon": "assets/img/balanca.png",
      "installerHeaderIcon": "assets/img/balanca.png"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/img/balanca.png"
    },
    "linux": {
      "category": "Utility",
      "icon": "assets/img/balanca.png",
      "target": [
        "deb",
        "AppImage",
        "rpm"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "JZ-TECH-SYS",
      "repo": "GerenciadorBalanca"
    }
  }
}
